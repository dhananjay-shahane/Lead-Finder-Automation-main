# ================================================================
# NVIDIA AI INTEGRATION (Primary AI Provider)
# ================================================================
NVIDIA_API_KEY="YOUR_NVIDIA_API_KEY"
NVIDIA_MODEL="meta/llama-3.2-11b-vision-instruct"

# ================================================================
# GOOGLE SHEETS WEBHOOK (Required for syncing leads)
# ================================================================
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec"

# ================================================================
# OPTIONAL AI FALLBACKS (Gemini / OpenRouter)
# ================================================================
GEMINI_API_KEY="MY_GEMINI_API_KEY"
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# ================================================================
# SMTP EMAIL OUTREACH (Optional)
# ================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="Your Name <your-email@gmail.com>"

# ================================================================
# HTTPSMS INTEGRATION (SMS Gateway via Android)
# ================================================================
HTTPSMS_API_KEY="YOUR_HTTPSMS_API_KEY"
HTTPSMS_FROM_NUMBER="+91XXXXXXXXXX"

# ================================================================
# GENERAL APP CONFIGURATION
# ================================================================
APP_URL="http://localhost:3000"
NODE_ENV="development"